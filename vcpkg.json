{
  "dependencies": [
    "boost-geometry",
    "boost-iostreams",
    "boost-program-options",
    {
      "name": "bullet3",
      "version>=": "3.25",
      "features": [
        "double-precision",
        "multithreading"
      ]
    },
    "ffmpeg",
    "freetype",
    "icu",
    "luajit",
    "lz4",
    {
      "name": "msdfgen",
      "default-features": false,
      "features": [
        "extensions"
      ]
    },
    {
      "name": "mygui",
      "version>=": "3.5.4",
      "features": [
        "msdf"
      ]
    },
    "openal-soft",
    "openmw-osg",
    {
      "name": "sdl2",
      "platform": "!linux"
    },
    {
      "name": "sdl2",
      "default-features": false,
      "platform": "linux",
      "features": [
        "dbus",
        "x11",
        "wayland"
      ]
    },
    {
      "name": "unshield",
      "platform": "osx|linux"
    }
  ],
  "builtin-baseline": "d805066cedcf6b13c2934832028723ea21e9477e",
  "overrides": [
    {
      "name": "vcpkg-tool-meson",
      "version": "1.9.0"
    },
    {
      "name": "bullet3",
      "version": "3.25"
    },
    {
      "name": "mygui",
      "version": "3.5.4"
    }
  ]
}
